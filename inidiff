#!/usr/bin/env python3
"""Compare INI files by section and key (Python 3.12+)."""

import argparse
import os
from pathlib import Path
import sys


type IniData = dict[str | None, dict[str, str]]


def use_color(no_color: bool) -> bool:
    """Explicit opt-out takes precedence over the environment and TTY detection."""
    if no_color or os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("FORCE_COLOR"):
        return True
    return sys.stdout.isatty()


def read_ini(path: Path) -> IniData:
    """Keep key case and literal values, including percent signs and equals signs."""
    data: IniData = {}
    section = None
    with path.open(encoding="utf-8-sig") as source:
        for number, line in enumerate(source, start=1):
            line = line.strip()
            if not line or line.startswith((";", "#")):
                continue
            if line.startswith("["):
                if not line.endswith("]") or not line[1:-1].strip():
                    raise ValueError(f"{path}:{number}: Invalid section header")
                section = line[1:-1].strip()
                data.setdefault(section, {})
                continue
            key, _, value = line.partition("=")
            if not key.strip():
                raise ValueError(f"{path}:{number}: Empty key")
            data.setdefault(section, {})[key.strip()] = value.strip()
    return data


def print_diff(left: IniData, right: IniData, color: bool) -> None:
    def emit(line: str) -> None:
        code = "31" if line.startswith(("-", "<")) else "32"
        print(f"\033[{code}m{line}\033[0m" if color else line)

    for section in dict.fromkeys((*left, *right)):
        old = left.get(section, {})
        new = right.get(section, {})
        if section in left and section in right and old == new:
            continue
        prefix = "- " if section not in right else "+ " if section not in left else ""
        if section is not None:
            header = f"{prefix}[{section}]"
            if prefix:
                emit(header)
            else:
                print(header)
        for key, value in old.items():
            if key not in new:
                emit(f"- {key} = {value}")
            elif value != new[key]:
                emit(f"< {key} = {value}")
                emit(f"> {key} = {new[key]}")
        for key, value in new.items():
            if key not in old:
                emit(f"+ {key} = {value}")
        print()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, add_help=False)
    parser.add_argument("-h", "-?", "--help", action="help", help="Show this help message and exit")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI colors")
    parser.add_argument("file1", type=Path)
    parser.add_argument("file2", type=Path)
    args = parser.parse_args(argv)
    try:
        left = read_ini(args.file1)
        right = read_ini(args.file2)
    except (OSError, UnicodeError, ValueError) as error:
        print(f"{parser.prog}: {error}", file=sys.stderr)
        return 1
    print_diff(left, right, use_color(args.no_color))
    return 0


if __name__ == "__main__":
    sys.exit(main())
