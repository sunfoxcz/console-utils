#!/usr/bin/env python3
"""Compare the child fields of XML elements selected by XPath (Python 3.12+)."""

import argparse
import os
from pathlib import Path
import sys

from lxml import etree


type XmlItems = dict[str, dict[str, str]]


def use_color(no_color: bool) -> bool:
    """Explicit opt-out takes precedence over the environment and TTY detection."""
    if no_color or os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("FORCE_COLOR"):
        return True
    return sys.stdout.isatty()


def field_value(child: etree._Element) -> str:
    if len(child):
        return (
            (child.text or "")
            + "".join(etree.tostring(part, encoding="unicode") for part in child)
        ).strip()
    return (child.text or "").strip()


def read_items(
    path: Path, xpath: str, compare_tag: str | None, ignore_tags: set[str]
) -> XmlItems:
    parser = etree.XMLParser(remove_blank_text=True, resolve_entities=False, no_network=True)
    tree = etree.parse(str(path), parser)
    nodes = tree.xpath(xpath)
    if not isinstance(nodes, list):
        raise ValueError("XPath must select elements")
    items: XmlItems = {}
    for position, node in enumerate(nodes, start=1):
        if not isinstance(node, etree._Element) or not isinstance(node.tag, str):
            raise ValueError("XPath must select elements")
        fields = {}
        key = None
        for child in node:
            if not isinstance(child.tag, str):
                continue
            if child.tag == compare_tag:
                key = (child.text or "").strip()
            if child.tag not in ignore_tags:
                fields[child.tag] = field_value(child)
        if compare_tag is None:
            key = str(position)
        elif not key:
            raise ValueError(f"{path}: Element {position} has no non-empty {compare_tag!r} tag")
        if key in items:
            raise ValueError(f"{path}: Duplicate comparison key {key!r}")
        items[key] = fields
    return items


def print_diff(left: XmlItems, right: XmlItems, label: str, color: bool) -> None:
    def emit(line: str) -> None:
        code = "31" if line.startswith(("-", "<")) else "32"
        print(f"\033[{code}m{line}\033[0m" if color else line)

    for key in dict.fromkeys((*left, *right)):
        old = left.get(key, {})
        new = right.get(key, {})
        if key in left and key in right and old == new:
            continue
        prefix = "- " if key not in right else "+ " if key not in left else ""
        header = f"{prefix}{label}: {key}"
        if prefix:
            emit(header)
        else:
            print(header)
        for tag, value in old.items():
            if tag not in new:
                emit(f"- {tag}: {value}")
            elif value != new[tag]:
                emit(f"< {tag}: {value}")
                emit(f"> {tag}: {new[tag]}")
        for tag, value in new.items():
            if tag not in old:
                emit(f"+ {tag}: {value}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, add_help=False)
    parser.add_argument("-h", "-?", "--help", action="help", help="Show this help message and exit")
    parser.add_argument("-c", "--compare-tag", help="Match elements by this child tag (default: position)")
    parser.add_argument("-i", "--ignore-tags", default="", help="Comma-separated child tags to ignore")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI colors")
    parser.add_argument("file1", type=Path)
    parser.add_argument("file2", type=Path)
    parser.add_argument("path", help="XPath selecting the elements to compare")
    args = parser.parse_args(argv)
    ignore_tags = {tag.strip() for tag in args.ignore_tags.split(",") if tag.strip()}
    try:
        left = read_items(args.file1, args.path, args.compare_tag, ignore_tags)
        right = read_items(args.file2, args.path, args.compare_tag, ignore_tags)
    except (OSError, etree.LxmlError, ValueError) as error:
        print(f"{parser.prog}: {error}", file=sys.stderr)
        return 1
    print_diff(left, right, args.compare_tag or "position", use_color(args.no_color))
    return 0


if __name__ == "__main__":
    sys.exit(main())
