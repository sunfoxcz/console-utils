#!/usr/bin/env python3

from collections import OrderedDict
from optparse    import OptionParser
from os.path     import isfile
from lxml        import etree
from sys         import exit

import re

# ------------------------------------------------------------------------------

parser = ArgumentParser(description="XML file diff utility.")
parser.add_argument("file1")
parser.add_argument("file2")
parser.add_argument("path")
parser.add_argument("compare_tag")
parser.add_argument("ignore_tags")
options = parser.parse_args()

# ------------------------------------------------------------------------------

parser = OptionParser("Usage: %prog <file1> <file2> <xpath>")

def print_help(option, opt, value, parser):
	parser.print_help()
	exit(0)
#enddef

parser.remove_option("-h")
parser.add_option("-?", "--help", action="callback", callback=print_help)
parser.add_option("-c", "--compare-tag", dest="compare_tag",
					help="Compare using tag name")
parser.add_option("-i", "--ignore-tags", dest="ignore_tags",
					help="Comma separated list of tags to ignore during comparison")

(options, args) = parser.parse_args()

if len(args) < 2:
	parser.print_help()
	exit(1)
#endif

file1 = args[0]
file2 = args[1]
path = args[2]

if not isfile(file1):
	print("Cannot read file %s" % file1)
	exit(1)
#endif

if not isfile(file2):
	print("Cannot read file %s" % file2)
	exit(1)
#endif
 
ignore_tags = ignore_tags.split(",")

# ------------------------------------------------------------------------------

items_by_compare_tag_left = {}

tree1 = etree.parse(file1)
for node in tree1.xpath(path):
	key = None
	item = {}

	for child in node:
		if child.tag in ignore_tags:
			continue
		#endif

		subchilds = child.getchildren()

		if subchilds:
			item[child.tag] = "".join([etree.tostring(s) for s in subchilds]).strip()
			# TODO: Tohle sice funguje, ale kvuli poradi vnorenych tagu to chce porovnavat rekurzivne
			item[child.tag] = re.sub(r"</([^>]+)>([^<]*)<([^>/]+)>", "</\\1><\\3>", item[child.tag])
			item[child.tag] = re.sub(r"([^>]*)<([^>]+)/>([^<]*)", "<\\2/>", item[child.tag])
			item[child.tag] = re.sub(r"</([^>]+)>([^<]*)</([^>]+)>", "</\\1></\\3>", item[child.tag])
			item[child.tag] = re.sub(r">([\r\n\t ]+)<", "><", item[child.tag])
		elif child.text:
			item[child.tag] = child.text.strip()
		else:
			item[child.tag] = ""
		#endif

		if child.tag == compare_tag:
			key = child.text.strip()
		#endif
	#endfor

	items_by_compare_tag_left[key] = item
#endfor

# ------------------------------------------------------------------------------

items_by_compare_tag_right = {}

tree2 = etree.parse(file2)
for node in tree2.xpath(path):
	key = None
	item = {}

	for child in node:
		if child.tag in ignore_tags:
			continue
		#endif

		subchilds = child.getchildren()

		if subchilds:
			item[child.tag] = "".join([etree.tostring(s) for s in subchilds]).strip()
			# TODO: Tohle sice funguje, ale kvuli poradi vnorenych tagu to chce porovnavat rekurzivne
			item[child.tag] = re.sub(r"</([^>]+)>([^<]*)<([^>/]+)>", "</\\1><\\3>", item[child.tag])
			item[child.tag] = re.sub(r"([^>]*)<([^>]+)/>([^<]*)", "<\\2/>", item[child.tag])
			item[child.tag] = re.sub(r"</([^>]+)>([^<]*)</([^>]+)>", "</\\1></\\3>", item[child.tag])
			item[child.tag] = re.sub(r">([\r\n\t ]+)<", "><", item[child.tag])
		elif child.text:
			item[child.tag] = child.text.strip()
		else:
			item[child.tag] = ""
		#endif

		if child.tag == compare_tag:
			key = child.text.strip()
		#endif
	#endfor

	items_by_compare_tag_right[key] = item

	if items_by_compare_tag_left.has_key(key):
		diff = {}
		for key2, val in item.iteritems():
			if items_by_compare_tag_left[key][key2] != val:
				diff[key2] = (items_by_compare_tag_left[key][key2], val)
			#endif
		#endfor

		if len(diff):
			print("%s: %s" % (compare_tag, key))
			for k, v in diff.iteritems():
				print("< %s: %s" % (k, v[0]))
				print("> %s: %s" % (k, v[1]))
			#endfor
		#endif
	else:
		# print("+ %s" % str(item))
		pass
	#endif
#endfor
