#!/usr/bin/env python3
"""Show network interfaces and their IP addresses (Python 3.12+)."""

import argparse
import json
import subprocess
import sys


def format_interfaces(output: str) -> str:
    """Keep interface names and address ownership from iproute2's JSON output."""
    interfaces = json.loads(output)
    if not isinstance(interfaces, list):
        raise ValueError("Expected a JSON array from ip")

    name_width = max((len(interface["ifname"]) for interface in interfaces), default=0) + 2
    lines: list[str] = []
    for interface in interfaces:
        name = interface["ifname"]
        link_type = interface.get("link_type", "unknown")
        mac = interface.get("address", "-")
        lines.append(f"{name:<{name_width}}type {link_type} mac {mac}")
        for address in interface.get("addr_info", []):
            family = {"inet": "ipv4", "inet6": "ipv6"}.get(address["family"])
            if family is not None:
                lines.append(f"{'':{name_width}}{family} {address['local']}/{address['prefixlen']}")
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, add_help=False)
    parser.add_argument("-h", "-?", "--help", action="help", help="Show this help message and exit")
    parser.parse_args(argv)

    try:
        result = subprocess.run(
            ["ip", "-json", "address", "show"],
            capture_output=True,
            encoding="utf-8",
            check=True,
        )
    except FileNotFoundError:
        print(f"{parser.prog}: 'ip' not found; install iproute2", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as error:
        detail = error.stderr.strip() or f"ip exited with status {error.returncode}"
        print(f"{parser.prog}: {detail}", file=sys.stderr)
        return 1
    except (OSError, UnicodeError) as error:
        print(f"{parser.prog}: {error}", file=sys.stderr)
        return 1

    try:
        output = format_interfaces(result.stdout)
    except (ValueError, KeyError, TypeError, AttributeError) as error:
        print(f"{parser.prog}: Invalid JSON output from ip: {error}", file=sys.stderr)
        return 1
    if output:
        print(output)
    return 0


if __name__ == "__main__":
    sys.exit(main())
